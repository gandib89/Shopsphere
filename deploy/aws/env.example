# Copy to deploy/aws/.env on the EC2 host (chmod 600). Never commit the copy.
# sslip.io resolves <ip>.sslip.io to <ip>, so Caddy can get Let's Encrypt certs without a domain.
SHOP_HOST=1-2-3-4.sslip.io
AUTH_HOST=auth.1-2-3-4.sslip.io
KEYCLOAK_PUBLIC_URL=https://auth.1-2-3-4.sslip.io
MCP_PUBLIC_HOST=mcp.1-2-3-4.sslip.io

# Global MCP switch. Each tool also has its own MCP_TOOL_*_ENABLED flag (all default false);
# add the ones you are releasing here, e.g. MCP_TOOL_SEARCH_PRODUCTS_ENABLED=true.
MCP_ENABLED=true
# OAuth callback URLs the AI Connections page may hand out. Must match the
# shopsphere-mcp-client redirect URIs in Keycloak.
MCP_CLIENT_REDIRECT_URIS=http://localhost:6274/oauth/callback

# Generate each with: openssl rand -hex 32
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
ASSISTANT_DB_PASSWORD=
ASSISTANT_PRIVATE_DB_PASSWORD=
ASSISTANT_API_TOKEN=
ASSISTANT_CURSOR_SECRET=
MCP_WORKLOAD_CLIENT_SECRET=
ASSISTANT_OAUTH_CLIENT_SECRET=
KEYCLOAK_SYNC_CLIENT_SECRET=
