{
  "name": "@shopsphere/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node -e \"import('fs').then(async (fs) => { const { execFileSync } = await import('child_process'); for (const f of fs.readdirSync('src')) { if (f.endsWith('.js')) execFileSync(process.execPath, ['--check', 'src/' + f], { stdio: 'inherit' }); } })\"",
    "buyer:matrix": "node scripts/generate-buyer-release-matrix.js",
    "buyer:validate": "node scripts/validate-buyer-release.js",
    "pilot:validate": "node scripts/validate-public-pilot.js",
    "pilot:validate:controls": "node scripts/validate-public-pilot-controls.js",
    "pilot:validate:degradation": "node scripts/validate-public-pilot-degradation.js",
    "pilot:validate:flag": "node scripts/validate-public-pilot-flag.js",
    "pilot:validate:security": "node scripts/validate-public-pilot-security.js",
    "start": "node src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "jose": "^6.2.12",
    "redis": "^5.12.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
