// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// All ids are the original MongoDB ObjectId hex strings (24 chars), carried
// over as-is during migration so existing JWTs and client-cached ids keep working.

model User {
  id                           String    @id @db.VarChar(24)
  firstName                    String
  lastName                     String
  email                        String    @unique
  phone                        String?
  password                     String?
  googleId                     String?
  role                         String    @default("user") // "user" | "admin" | "seller"
  shopName                     String?
  shopDescription              String?
  isVerified                   Boolean   @default(false)
  verificationRequestDate      DateTime?
  verificationApprovedDate     DateTime?
  verificationRejectionReason  String?
  createdAt                    DateTime  @default(now())

  productsAsSeller  Product[]        @relation("ProductSeller")
  orders            Order[]          @relation("OrderUser")
  carts             Cart[]
  revenuesAsSeller  Revenue[]        @relation("RevenueSeller")
  revenuesAsAdmin   Revenue[]        @relation("RevenueAdmin")
  notifications     Notification[]
  promoCodesCreated PromoCode[]      @relation("PromoCreatedBy")
  promoCodeUsages   PromoCodeUsage[]
  bills             Bill[]
  productReviews    ProductReview[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

// Rotating refresh tokens, grouped by familyId. Reuse of an already-`usedAt` token
// revokes every token in its family (stolen-token signal) — see utils/refreshTokenStore.js.
model RefreshToken {
  id        String    @id @db.VarChar(24)
  userId    String    @db.VarChar(24)
  user      User      @relation(fields: [userId], references: [id])
  familyId  String    @db.VarChar(24)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id                String    @id @db.VarChar(24)
  name              String
  price             Float
  quantity          Int
  description       String?
  images            String[]
  category          String
  variantStorage    String[]  @default([])
  variantColor      String[]  @default([])
  variantRam        String[]  @default([])
  variantScreenSize String[]  @default([])
  variantProcessor  String[]  @default([])
  sellerId          String?   @db.VarChar(24)
  seller            User?     @relation("ProductSeller", fields: [sellerId], references: [id])
  discount          Float     @default(0)
  discountUpdatedAt DateTime?
  createdAt         DateTime  @default(now())

  colorVariants   ProductColorVariant[]
  storageVariants ProductStorageVariant[]
  reviews         ProductReview[]
  orders          Order[]
  cartItems       CartItem[]
  revenues        Revenue[]
  notifications   Notification[]
  bills           Bill[]

  @@map("products")
}

model ProductColorVariant {
  id        String  @id @default(cuid())
  productId String  @db.VarChar(24)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String?
  images    String[] @default([])
  stock     Int      @default(0)

  @@index([productId, color])
  @@map("product_color_variants")
}

model ProductStorageVariant {
  id        String  @id @default(cuid())
  productId String  @db.VarChar(24)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storage   String?
  stock     Int     @default(0)

  @@index([productId, storage])
  @@map("product_storage_variants")
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String   @db.VarChar(24)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userName  String
  userId    String?  @db.VarChar(24)
  user      User?    @relation(fields: [userId], references: [id])
  orderId   String?  @db.VarChar(24)
  order     Order?   @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@map("product_reviews")
}

model Order {
  id                    String    @id @db.VarChar(24)
  firstName             String
  lastName              String
  productId             String    @db.VarChar(24)
  product               Product   @relation(fields: [productId], references: [id])
  quantity              Int
  deliveryDate          DateTime
  email                 String
  deliveryStreet        String?
  deliveryCity          String?
  deliveryState         String?
  deliveryZipCode       String?
  deliveryCountry       String?   @default("Nepal")
  totalPrice            Float
  adminCommission       Float     @default(0)
  status                String    @default("Pending")
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  returnRequestedAt     DateTime?
  returnReason          String?
  returnImage           String?
  refundReleasedAt      DateTime?
  variantStorage        String?
  variantColor          String?
  variantRam            String?
  variantScreenSize     String?
  variantProcessor      String?
  size                  String?
  color                 String?
  billId                String?   @db.VarChar(24)
  bill                  Bill?     @relation("OrderBill", fields: [billId], references: [id])
  userId                String?   @db.VarChar(24)
  user                  User?     @relation("OrderUser", fields: [userId], references: [id])
  confirmationEmailSent Boolean   @default(false)
  orderNumber           String?   @unique
  orderGroupId          String?
  promoCode             String?
  promoDiscountAmount   Float?
  confirmedAt           DateTime?
  processingAt          DateTime?
  shippedAt             DateTime?
  createdAt             DateTime  @default(now())

  bills    Bill[]          @relation("BillOrder")
  revenues Revenue[]
  reviews  ProductReview[]

  @@index([email])
  @@index([createdAt])
  @@index([email, createdAt])
  @@index([orderGroupId])
  @@map("orders")
}

model Cart {
  id         String   @id @db.VarChar(24)
  userId     String   @db.VarChar(24)
  user       User     @relation(fields: [userId], references: [id])
  email      String
  totalPrice Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @db.VarChar(24)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @db.VarChar(24)
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Float
  variants  Json     @default("{}")
  addedAt   DateTime @default(now())

  @@map("cart_items")
}

model Revenue {
  id              String   @id @db.VarChar(24)
  orderId         String   @db.VarChar(24)
  order           Order    @relation(fields: [orderId], references: [id])
  sellerId        String   @db.VarChar(24)
  seller          User     @relation("RevenueSeller", fields: [sellerId], references: [id])
  adminId         String?  @db.VarChar(24)
  admin           User?    @relation("RevenueAdmin", fields: [adminId], references: [id])
  productId       String   @db.VarChar(24)
  product         Product  @relation(fields: [productId], references: [id])
  totalSalePrice  Float
  adminCommission Float    @default(0)
  sellerRevenue   Float    @default(0)
  quantity        Int?
  transactionDate DateTime @default(now())
  month           Int? // actual runtime value is 1-12 (getMonth()+1), despite historic Mongo schema comment saying 0-11
  year            Int?
  status          String   @default("Completed")

  @@index([sellerId, year, month])
  @@index([adminId, year, month])
  @@map("revenues")
}

model Notification {
  id           String   @id @db.VarChar(24)
  userId       String   @db.VarChar(24)
  user         User     @relation(fields: [userId], references: [id])
  type         String
  title        String
  message      String
  read         Boolean  @default(false)
  productId    String?  @db.VarChar(24)
  product      Product? @relation(fields: [productId], references: [id])
  productName  String?
  productImage String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model PromoCode {
  id            String   @id @db.VarChar(24)
  code          String   @unique
  description   String
  discountType  String
  discountValue Float
  minPurchase   Float    @default(0)
  maxDiscount   Float?
  usageLimit    Int?
  usedCount     Int      @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean  @default(true)
  createdById   String   @db.VarChar(24)
  createdBy     User     @relation("PromoCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  usages PromoCodeUsage[]

  @@index([code, isActive])
  @@map("promo_codes")
}

model PromoCodeUsage {
  promoCodeId String    @db.VarChar(24)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String    @db.VarChar(24)
  user        User      @relation(fields: [userId], references: [id])

  @@id([promoCodeId, userId])
  @@map("promo_code_usages")
}

model Bill {
  id              String    @id @db.VarChar(24)
  orderId         String    @db.VarChar(24)
  order           Order     @relation("BillOrder", fields: [orderId], references: [id])
  userId          String    @db.VarChar(24)
  user            User      @relation(fields: [userId], references: [id])
  productId       String    @db.VarChar(24)
  product         Product   @relation(fields: [productId], references: [id])
  billNumber      String    @unique
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  productName     String?
  quantity        Int?
  unitPrice       Float?
  totalPrice      Float?
  adminCommission Float?
  sellerRevenue   Float?
  deliveryStreet  String?
  deliveryCity    String?
  deliveryState   String?
  deliveryZipCode String?
  deliveryCountry String?
  deliveryDate    DateTime?
  orderDate       DateTime  @default(now())
  status          String    @default("Generated")

  ordersReferencing Order[] @relation("OrderBill")

  @@map("bills")
}
