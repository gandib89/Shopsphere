// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// All ids are the original MongoDB ObjectId hex strings (24 chars), carried
// over as-is during migration so existing JWTs and client-cached ids keep working.

model User {
  id                          String    @id @db.VarChar(24)
  firstName                   String
  lastName                    String
  email                       String    @unique
  phone                       String?
  homeStreet                  String?
  homeCity                    String?
  homeState                   String?
  homeZipCode                 String?
  password                    String?
  googleId                    String?   @unique
  role                        String    @default("user") // "user" | "admin" | "seller"
  shopName                    String?
  shopDescription             String?
  isVerified                  Boolean   @default(false)
  verificationRequestDate     DateTime?
  verificationApprovedDate    DateTime?
  verificationRejectionReason String?
  resetTokenHash              String?   @unique
  resetTokenExpiresAt         DateTime?
  createdAt                   DateTime  @default(now())

  productsAsSeller  Product[]        @relation("ProductSeller")
  orders            Order[]          @relation("OrderUser")
  ordersAsSellerAtPurchase Order[]   @relation("OrderSellerAtPurchase")
  carts             Cart[]
  revenuesAsSeller  Revenue[]        @relation("RevenueSeller")
  revenuesAsAdmin   Revenue[]        @relation("RevenueAdmin")
  notifications     Notification[]
  promoCodesCreated PromoCode[]      @relation("PromoCreatedBy")
  promoCodeUsages   PromoCodeUsage[]
  bills             Bill[]
  productReviews    ProductReview[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

// Rotating refresh tokens, grouped by familyId. Reuse of an already-`usedAt` token
// revokes every token in its family (stolen-token signal) — see utils/refreshTokenStore.js.
model RefreshToken {
  id        String    @id @db.VarChar(24)
  userId    String    @db.VarChar(24)
  user      User      @relation(fields: [userId], references: [id])
  familyId  String    @db.VarChar(24)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id                String    @id @db.VarChar(24)
  name              String
  price             Decimal   @db.Decimal(12, 2)
  quantity          Int
  description       String?
  images            String[]
  category          String
  variantStorage    String[]  @default([])
  variantColor      String[]  @default([])
  variantRam        String[]  @default([])
  variantScreenSize String[]  @default([])
  variantProcessor  String[]  @default([])
  isArchived        Boolean   @default(false)
  sellerId          String?   @db.VarChar(24)
  seller            User?     @relation("ProductSeller", fields: [sellerId], references: [id])
  discount          Decimal   @default(0) @db.Decimal(5, 2)
  discountUpdatedAt DateTime?
  createdAt         DateTime  @default(now())

  colorVariants   ProductColorVariant[]
  storageVariants ProductStorageVariant[]
  options         ProductOption[]
  reviews         ProductReview[]
  orders          Order[]
  cartItems       CartItem[]
  revenues        Revenue[]
  notifications   Notification[]
  bills           Bill[]

  @@map("products")
  @@index([sellerId])
}

model ProductColorVariant {
  id        String   @id @default(cuid())
  productId String   @db.VarChar(24)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String?
  images    String[] @default([])
  stock     Int      @default(0)

  @@index([productId, color])
  @@map("product_color_variants")
}

model ProductStorageVariant {
  id        String  @id @default(cuid())
  productId String  @db.VarChar(24)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  storage   String?
  stock     Int     @default(0)

  @@index([productId, storage])
  @@map("product_storage_variants")
}

// One row per selectable option across every kind (color, storage, ram, screenSize,
// processor). priceDelta is added to the product's base price when that option is chosen, so a
// base-price change never requires rewriting each option. stock is null when the option does
// not track its own inventory and the product-level quantity governs.
model ProductOption {
  id         String  @id @default(cuid())
  productId  String  @db.VarChar(24)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind       String
  value      String
  priceDelta Decimal @default(0) @db.Decimal(12, 2)
  stock      Int?

  @@unique([productId, kind, value])
  @@index([productId, kind])
  @@map("product_options")
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String   @db.VarChar(24)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userName  String
  userId    String?  @db.VarChar(24)
  user      User?    @relation(fields: [userId], references: [id])
  orderId   String?  @db.VarChar(24)
  order     Order?   @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@map("product_reviews")
}

model Order {
  id                    String    @id @db.VarChar(24)
  firstName             String
  lastName              String
  productId             String    @db.VarChar(24)
  product               Product   @relation(fields: [productId], references: [id])
  quantity              Int
  deliveryDate          DateTime
  email                 String
  deliveryStreet        String?
  deliveryCity          String?
  deliveryState         String?
  deliveryZipCode       String?
  deliveryCountry       String?   @default("Nepal")
  totalPrice            Decimal   @db.Decimal(12, 2)
  adminCommission       Decimal   @default(0) @db.Decimal(12, 2)
  status                String    @default("Pending")
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  returnRequestedAt     DateTime?
  returnReason          String?
  returnImage           String?
  refundReleasedAt      DateTime?
  variantStorage        String?
  variantColor          String?
  variantRam            String?
  variantScreenSize     String?
  variantProcessor      String?
  size                  String?
  color                 String?
  billId                String?   @db.VarChar(24)
  bill                  Bill?     @relation("OrderBill", fields: [billId], references: [id])
  userId                String?   @db.VarChar(24)
  user                  User?     @relation("OrderUser", fields: [userId], references: [id])
  // Immutable seller attribution captured at purchase time. Never updated afterwards:
  // a later Product.sellerId transfer must not move historical sales to the new owner.
  // Null = legacy/unrepaired row, quarantined from assistant reads until backfilled.
  sellerIdAtPurchase    String?   @db.VarChar(24)
  sellerAtPurchase      User?     @relation("OrderSellerAtPurchase", fields: [sellerIdAtPurchase], references: [id], onDelete: SetNull)
  confirmationEmailSent Boolean   @default(false)
  orderNumber           String?   @unique
  orderGroupId          String?
  promoCode             String?
  promoDiscountAmount   Decimal?  @db.Decimal(12, 2)
  confirmedAt           DateTime?
  processingAt          DateTime?
  shippedAt             DateTime?
  createdAt             DateTime  @default(now())

  bills    Bill[]          @relation("BillOrder")
  revenues Revenue[]
  reviews  ProductReview[]
  payments Payment[]
  refunds  Refund[]

  @@index([email])
  @@index([createdAt])
  @@index([email, createdAt])
  @@index([orderGroupId])
  @@index([userId, createdAt])
  @@index([sellerIdAtPurchase, createdAt])
  @@map("orders")
}

// One row per checkout attempt (Idempotency-Key header). Unique constraint on `key` is what
// makes concurrent duplicate requests safe — see withIdempotency() in utils/idempotency.js.
model IdempotencyKey {
  key         String   @id
  requestHash String
  status      String   @default("processing") // processing | completed
  statusCode  Int?
  response    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("idempotency_keys")
}

// Append-only audit trail of every payment state transition. Never updated or deleted by
// application code. gatewayEventId dedupes redelivered/duplicate gateway callbacks.
model PaymentEvent {
  id             String   @id @db.VarChar(24)
  aggregateId    String   @db.VarChar(24)
  eventType      String
  payload        Json
  gatewayEventId String?  @unique
  createdAt      DateTime @default(now())

  @@index([aggregateId, createdAt])
  @@map("payment_events")
}

// Read-model projection of payment state, kept in sync by inserts into PaymentEvent.
model Payment {
  id              String   @id @db.VarChar(24)
  orderId         String   @db.VarChar(24)
  order           Order    @relation(fields: [orderId], references: [id])
  orderGroupId    String?
  transactionUuid String   @unique
  productCode     String
  amount          Decimal  @db.Decimal(12, 2)
  status          String   @default("Initiated") // Initiated | Succeeded | Failed
  gatewayRefId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  refund          Refund?

  @@index([orderId])
  @@index([orderGroupId])
  @@map("payments")
}

// A full refund has its own lifecycle. The unique paymentId prevents duplicate refunds when
// an admin double-clicks or two requests arrive concurrently.
model Refund {
  id               String    @id @db.VarChar(24)
  paymentId        String    @unique @db.VarChar(24)
  payment          Payment   @relation(fields: [paymentId], references: [id])
  orderId          String    @db.VarChar(24)
  order            Order     @relation(fields: [orderId], references: [id])
  amount           Decimal   @db.Decimal(12, 2)
  status           String    @default("Processing") // Processing | Succeeded | Failed
  mode             String    @default("sandbox")
  providerRefundId String?
  idempotencyKey   String    @unique
  failureReason    String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([orderId, createdAt])
  @@map("refunds")
}

model Cart {
  id         String   @id @db.VarChar(24)
  userId     String   @db.VarChar(24)
  user       User     @relation(fields: [userId], references: [id])
  email      String
  totalPrice Decimal  @default(0) @db.Decimal(12, 2)
  // Optimistic-concurrency guard for proposal execution (#22): bumped atomically
  // (+1) by every cart mutation so a proposal can pin the version it previewed.
  version    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @db.VarChar(24)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String   @db.VarChar(24)
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(12, 2)
  variants  Json     @default("{}")
  addedAt   DateTime @default(now())

  @@map("cart_items")
}

model Revenue {
  id              String   @id @db.VarChar(24)
  orderId         String   @db.VarChar(24)
  order           Order    @relation(fields: [orderId], references: [id])
  sellerId        String?  @db.VarChar(24)
  seller          User?    @relation("RevenueSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  adminId         String?  @db.VarChar(24)
  admin           User?    @relation("RevenueAdmin", fields: [adminId], references: [id])
  productId       String   @db.VarChar(24)
  product         Product  @relation(fields: [productId], references: [id])
  totalSalePrice  Decimal  @db.Decimal(12, 2)
  adminCommission Decimal  @default(0) @db.Decimal(12, 2)
  sellerRevenue   Decimal  @default(0) @db.Decimal(12, 2)
  quantity        Int?
  transactionDate DateTime @default(now())
  month           Int? // actual runtime value is 1-12 (getMonth()+1), despite historic Mongo schema comment saying 0-11
  year            Int?
  status          String   @default("Completed")

  @@index([sellerId, year, month])
  @@index([adminId, year, month])
  @@map("revenues")
}

model Notification {
  id           String   @id @db.VarChar(24)
  userId       String   @db.VarChar(24)
  user         User     @relation(fields: [userId], references: [id])
  type         String
  title        String
  message      String
  read         Boolean  @default(false)
  productId    String?  @db.VarChar(24)
  product      Product? @relation(fields: [productId], references: [id])
  productName  String?
  productImage String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model AssistantAuditEvent {
  id                   String   @id @db.Uuid
  traceId              String   @db.VarChar(100)
  layer                String   @db.VarChar(20)
  subjectId            String?  @db.VarChar(24)
  role                 String?  @db.VarChar(20)
  clientId             String?  @db.VarChar(200)
  workloadId           String?  @db.VarChar(200)
  grantId              String?  @db.VarChar(200)
  policyVersion        String   @db.VarChar(50)
  tool                 String?  @db.VarChar(100)
  operation            String   @db.VarChar(100)
  authorizationOutcome String   @db.VarChar(30)
  outcome              String   @db.VarChar(50)
  redactedInput        Json
  returnedFields       String[]
  resourceIds          String[]
  responseDigest       String?  @db.VarChar(100)
  responseBytes        Int?
  rowCount             Int?
  latencyMs            Int
  failureReason        String?  @db.VarChar(100)
  createdAt            DateTime @default(now())

  @@index([traceId])
  @@index([subjectId, createdAt])
  @@index([operation, outcome, createdAt])
  @@map("assistant_audit_events")
}

model PromoCode {
  id            String   @id @db.VarChar(24)
  code          String   @unique
  description   String
  discountType  String
  discountValue Decimal  @db.Decimal(12, 2)
  minPurchase   Decimal  @default(0) @db.Decimal(12, 2)
  maxDiscount   Decimal? @db.Decimal(12, 2)
  usageLimit    Int?
  usedCount     Int      @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean  @default(true)
  createdById   String   @db.VarChar(24)
  createdBy     User     @relation("PromoCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  usages PromoCodeUsage[]

  @@index([code, isActive])
  @@map("promo_codes")
}

model PromoCodeUsage {
  promoCodeId String    @db.VarChar(24)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String    @db.VarChar(24)
  user        User      @relation(fields: [userId], references: [id])

  @@id([promoCodeId, userId])
  @@map("promo_code_usages")
}

model Bill {
  id              String    @id @db.VarChar(24)
  orderId         String    @db.VarChar(24)
  order           Order     @relation("BillOrder", fields: [orderId], references: [id])
  userId          String?   @db.VarChar(24)
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId       String    @db.VarChar(24)
  product         Product   @relation(fields: [productId], references: [id])
  billNumber      String    @unique
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  productName     String?
  quantity        Int?
  unitPrice       Decimal?  @db.Decimal(12, 2)
  totalPrice      Decimal?  @db.Decimal(12, 2)
  adminCommission Decimal?  @db.Decimal(12, 2)
  sellerRevenue   Decimal?  @db.Decimal(12, 2)
  deliveryStreet  String?
  deliveryCity    String?
  deliveryState   String?
  deliveryZipCode String?
  deliveryCountry String?
  deliveryDate    DateTime?
  orderDate       DateTime  @default(now())
  status          String    @default("Generated")

  ordersReferencing Order[] @relation("OrderBill")

  @@map("bills")
}

// Canonical cart-change proposal (#22). Created by the assistant operation
// proposals.proposeCartChange from the delegated token's subject/role/client/
// grant; executed only by the first-party browser endpoint. Payload columns are
// immutable at the database level (trigger proposals_payload_immutable); only
// status/execution columns may transition. executionReference is a deterministic
// outcome reference (proposal-exec-<id>), never a credential.
model Proposal {
  id                 String    @id @db.VarChar(24)
  subjectId          String    @db.VarChar(24)
  role               String    @db.VarChar(20)
  clientId           String    @db.VarChar(200)
  grantId            String    @db.VarChar(200)
  actionKind         String    @db.VarChar(40) // "cart.add_item" | "cart.update_quantity" | "cart.remove_item"
  targetType         String    @db.VarChar(20) // "cart_item" | "cart"
  targetId           String?   @db.VarChar(24)
  canonicalPayload   Json
  preview            Json
  expectedVersion    Int
  payloadHash        String    @db.VarChar(64)
  status             String    @default("pending") @db.VarChar(20) // pending | executed | expired | stale | rejected
  expiresAt          DateTime
  executedAt         DateTime?
  executionReference String?   @db.VarChar(100)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  outboxEvents ProposalOutboxEvent[]

  @@index([subjectId, createdAt])
  @@index([status, expiresAt])
  @@map("proposals")
}

// Append-only outbox for proposal outcomes (created | executed | expired |
// stale | rejected). Rows are inserted in the same transaction as the proposal
// write or cart mutation; a database trigger rejects UPDATE and DELETE.
model ProposalOutboxEvent {
  id          String   @id @db.Uuid
  proposalId  String   @db.VarChar(24)
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  eventType   String   @db.VarChar(20)
  payloadHash String   @db.VarChar(64)
  occurredAt  DateTime @default(now())

  @@index([proposalId, occurredAt])
  @@map("proposal_outbox_events")
}
