{
  "realm": "shopsphere",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      { "name": "user" },
      { "name": "seller" },
      { "name": "admin" }
    ]
  },
  "clientScopes": [
    {
      "name": "shopsphere-identity",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "ShopSphere user id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "shopsphere_user_id",
            "claim.name": "shopsphere_user_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "ShopSphere role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "shopsphere_role",
            "claim.name": "shopsphere_role",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "MCP audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "shopsphere-mcp",
            "access.token.claim": "true"
          }
        }
      ]
    },
    { "name": "catalog:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" }, "protocolMappers": [] },
    { "name": "policy:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" }, "protocolMappers": [] },
    { "name": "profile:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" }, "protocolMappers": [] },
    { "name": "notifications:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" }, "protocolMappers": [] },
    { "name": "orders:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" }, "protocolMappers": [] },
    { "name": "cart:read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true" }, "protocolMappers": [] }
  ],
  "clients": [
    {
      "clientId": "shopsphere-mcp-client",
      "name": "ShopSphere approved MCP client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1:*/*", "http://localhost:*/*"],
      "webOrigins": ["http://127.0.0.1:*", "http://localhost:*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["openid", "profile", "shopsphere-identity"],
      "optionalClientScopes": [
        "catalog:read",
        "policy:read",
        "profile:read",
        "notifications:read",
        "orders:read",
        "cart:read"
      ]
    },
    {
      "clientId": "shopsphere-mcp-workload",
      "name": "ShopSphere MCP workload",
      "enabled": true,
      "publicClient": false,
      "secret": "${MCP_WORKLOAD_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": { "standard.token.exchange.enabled": "true" }
    },
    {
      "clientId": "shopsphere-assistant-api",
      "name": "ShopSphere assistant API",
      "enabled": true,
      "publicClient": false,
      "secret": "${ASSISTANT_OAUTH_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ]
}
